# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/secure_auth_db?schema=public"

# JWT Cryptographic Secrets (Change these to long, random strings in production)
JWT_SECRET="your-super-secret-access-token-key-change-this-in-production"
REFRESH_SECRET="your-super-secret-refresh-token-key-change-this-in-production"

# NextJS Frontend Origin URL (Used to construct verification and reset links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP Email Server Configuration (Nodemailer)
# Note: Leaving these blank triggers the mock logger fallback, printing emails directly to the console.
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="noreply@secureauth.com"
